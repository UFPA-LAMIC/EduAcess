        ContrastMode.DEFAULT: ("#fff", "#000", "#1a73e8"),
        ContrastMode.HIGH_CONTRAST: ("#000", "#fff", "#FFD500"),
        ContrastMode.SEPIA: ("#F7F0D9", "#5C4636", "#8B4513")
    }.get(contrast, ("#fff", "#000", "#1a73e8"))
    
    st.markdown(f"""<style>
        .stApp {{ background: {bg}; color: {fg}; }}
        .main-content {{ font-size: {f_size}px; background: {bg}; color: {fg}; padding: 20px; border: 1px solid {acc}; text-align: {align_opt.lower() if align_opt!='Justificado' else 'justify'}; white-space: pre-wrap; }}
    </style>""", unsafe_allow_html=True)

    st.title("Adaptador Didático Multimodal")

    col1, col2 = st.columns(2)
    
    with col1:
        st.subheader("Entrada")
        up = st.file_uploader("PDF/TXT", type=['pdf', 'txt'])
        txt = st.text_area("Texto Manual", height=150)
        
        if st.button("PROCESSAR", type="primary"):
            raw = ""
            if up:
                try: 
                    if up.type == "application/pdf":
                        pdf = PdfReader(io.BytesIO(up.read()))
                        raw = "\n".join([p.extract_text() for p in pdf.pages if p.extract_text()])
                    else: raw = up.read().decode('utf-8')
                except: st.error("Erro leitura")
            elif txt: raw = txt
            
            if raw:
                with st.spinner("Adaptando..."):
                    res = smart_process(raw, profile, DEFAULT_MODEL)
                    st.session_state.adapted_text = res
                    # Reseta áudio anterior
                    st.session_state.audio_bytes = None
                st.success("Texto pronto!")

    with col2:
        st.subheader("Saída")
        if st.session_state.adapted_text:
            st.markdown(f'<div class="main-content">{st.session_state.adapted_text}</div>', unsafe_allow_html=True)
            
            c1, c2 = st.columns(2)
            
            # PDF
            pdf = create_pdf(st.session_state.adapted_text, profile, f_size, align_opt)
            if pdf: c1.download_button("📄 Baixar PDF", pdf, "adaptado.pdf", "application/pdf")
            
            # ÁUDIO
            if profile == AccessibilityProfile.BLINDNESS:
                c2.markdown("### 🔊 Áudio (gTTS)")
                if st.session_state.audio_bytes:
                    st.audio(st.session_state.audio_bytes, format='audio/mp3')
                    c2.download_button("⬇️ MP3", st.session_state.audio_bytes, "leitura.mp3", "audio/mpeg")
                else:
                    if c2.button("Gerar Narração"):
                        with st.spinner("Gerando áudio com Google..."):
                            mp3_data, err = generate_audio_gtts(st.session_state.adapted_text)
                            if mp3_data:
                                st.session_state.audio_bytes = mp3_data
                                st.rerun()
                            else:
                                st.error(err)
            else:
                c2.info("Selecione 'Cegueira' para ativar o áudio.")

if __name__ == "__main__":
    main()
