# ==========================================
# MOTOR DE ÁUDIO (gTTS)
# ==========================================
def generate_audio_gtts(text):
    """
    Gera áudio usando a API do Google (Online).
    """
    if not text.strip(): return None, "Texto vazio."
    
    try:
        # Lang 'pt' = Português
        tts = gTTS(text=text, lang='pt', slow=False)
        
        # Salva em memória
        mp3_fp = io.BytesIO()
        tts.write_to_fp(mp3_fp)
        
        return mp3_fp.getvalue(), None
    except Exception as e:
        return None, f"Erro gTTS (Verifique a internet): {str(e)}"

# ==========================================
# MOTOR DE TEXTO
# ==========================================
def normalize_text(text):
    if not text: return ""
    return unicodedata.normalize('NFKC', text)

def adapt_math_content(text, profile):
    """
    Prepara o texto tanto para o PDF quanto para o Áudio (lendo fórmulas por extenso).
    """
    if not text: return ""
    t = normalize_text(text)
    
    # Limpeza básica
    replacements = {'\x00': '', '−': '-', '–': '-', '“': '"', '”': '"', '’': "'"}
    for k, v in replacements.items(): t = t.replace(k, v)

    # Tradução Matemática (Fundamental para o Cego ouvir "Integral" e não silêncio)
    if profile == AccessibilityProfile.BLINDNESS:
        math_map = {
            '∫': ' integral de ', '∑': ' somatorio de ', '∂': ' derivada parcial ', 
            '∇': ' nabla ', '∀': ' para todo ', '∈': ' pertence a ', '∞': ' infinito ', 
            '√': ' raiz quadrada de ', 'π': ' pi ', '→': ' tende a ', '≠': ' diferente de '
        }
        for k, v in math_map.items(): t = t.replace(k, v)
        # Regex para funções e potências
        t = re.sub(r'\b([a-zA-Z])\(([a-zA-Z0-9])\)', r'\1 de \2', t) 
        t = re.sub(r'\^2', ' ao quadrado', t)

    t = re.sub(r'\s+', ' ', t)
    return t

def smart_process(text, profile, model_name):
    # 1. Tratamento matemático
    text = adapt_math_content(text, profile)
    
    # 2. Bypass para perfis visuais (não precisa de IA para reescrever)
    if profile in [AccessibilityProfile.LOW_VISION, AccessibilityProfile.BLINDNESS]:
        return text

    # 3. Processamento Cognitivo com IA
    chunks = re.split(r'\n\s*\n', text)
    processed = []
    prog = st.progress(0)
    
    llm = None
    if LANGCHAIN_AVAILABLE:
        try: llm = ChatOllama(model=model_name, temperature=0.1)
        except: pass

    for i, c in enumerate(chunks):
        if len(c) < 5: continue
        instr = f"Adapte este texto para {profile.value}. Mantenha as fórmulas matemáticas intactas."
        try:
            if llm:
                prompt = ChatPromptTemplate.from_messages([("system", instr), ("human", "{t}")])
                resp = (prompt | llm).invoke({"t": c})
                processed.append(resp.content)
            else: processed.append(c)
        except: processed.append(c)
        prog.progress((i+1)/len(chunks))
    
    prog.empty()
    return "\n\n".join(processed)

# ==========================================
# GERAÇÃO PDF
# ==========================================
def create_pdf(text, profile, f_size, align):
    buff = io.BytesIO()
    doc = SimpleDocTemplate(buff, pagesize=A4, leftMargin=20*mm, rightMargin=20*mm, topMargin=20*mm, bottomMargin=20*mm)
    styles = getSampleStyleSheet()
    
    align_map = {"Esquerda": TA_LEFT, "Justificado": TA_JUSTIFY, "Centro": TA_CENTER, "Direita": TA_RIGHT}
    
    style_body = ParagraphStyle('ABody', parent=styles['Normal'], fontName=GLOBAL_FONT, fontSize=f_size, leading=f_size*1.5, alignment=align_map.get(align, TA_LEFT))
    style_head = ParagraphStyle('AHead', parent=styles['Heading2'], fontName=GLOBAL_FONT, fontSize=f_size+4, spaceAfter=15)

    elems = [Paragraph("Material Adaptado", style_head), Paragraph(f"Perfil: {profile.value}", style_body), Spacer(1, 10)]
    
    for p in text.split('\n'):
        p = p.strip()
        if not p: continue
        p_safe = p.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;')
        p_safe = re.sub(r'\*\*(.*?)\*\*', r'<b>\1</b>', p_safe).replace('\n', '<br/>')
        
        if p.isupper() and len(p)<80: elems.append(Paragraph(p_safe, style_head))
        else: elems.append(Paragraph(p_safe, style_body))
        
    try:
        doc.build(elems)
        buff.seek(0)
        return buff.getvalue()
    except: return None

